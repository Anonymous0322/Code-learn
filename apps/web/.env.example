# Set this to the public site origin used for production metadata and social previews.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Supabase > Project Settings > API (publishable/anon key only; never use service_role in the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
