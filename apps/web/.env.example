# Copy this file to .env.local and replace the placeholders with your project values.
NEXT_PUBLIC_SITE_URL=https://your-site.example.com

# Use the Supabase project URL and its publishable/anon key.
# Never put a secret/service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key